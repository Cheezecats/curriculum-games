config_version=5

[application]
config/name="Flight Islands"
config/icon="res://assets/branding/flight_islands_icon_1024.png"
config/description="Build something improbable. Make it fly."
run/max_fps=0
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
Boot="*res://core/bootstrap.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55,0.74,0.86,1)

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

[debug]
file_logging/enable_file_logging=false
gdscript/warnings/treat_warnings_as_errors=false
